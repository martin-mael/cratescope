{
  "name": "cratescope",
  "productName": "CrateScope",
  "version": "0.3.2",
  "description": "Analyse BPM, key, waveform and metadata of a music folder (Rekordbox-style)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "eval": "node scripts/eval.js",
    "package": "node scripts/package.js darwin arm64",
    "install_app": "npm run package && rm -rf /Applications/CrateScope.app && cp -R dist/CrateScope-darwin-arm64/CrateScope.app /Applications/",
    "package:mac-x64": "node scripts/package.js darwin x64",
    "package:win": "node scripts/package.js win32 x64"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.1.0"
  }
}
